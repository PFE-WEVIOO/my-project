                            "label": "",
                            "id": "field2",
                            "value": "<style>\n    \n    #verification_code {\n        display: none !important;\n    }\nlabel.label[for=\"verification_code\"] {\n    color: transparent; /* Make the label text invisible */\n    visibility: hidden; /* Hide the label text, but keep the space */\n}\n\nlabel.label[for=\"verification_code\"] .form-error-message {\n    color: red!important; /* Make the text inside <span class=\"form-error-message\"> red */\n    visibility: visible!important; /* Make sure the <span> text is visible */\n}\n\n\n<\/style>\n    <h2>Réinitialiser votre mot de passe<\/h2> <!-- Title for the form -->\n\n\n<style>\n\n/* General Form Styling */\n:root {\n    --primary-color: #007bff;\n    --primary-dark: #0056b3;\n    --primary-darker: #003f7f;\n    --accent-color: #457b9d;\n    --error-color: #e63946;\n    --success-color: #2a9d8f;\n    --background-color: #f7f7f7;\n    --border-color: #ced4da;\n    --text-color: #333;\n    --input-bg-color: #fff;\n    --shadow-light: rgba(0, 0, 0, 0.1);\n    --shadow-dark: rgba(0, 0, 0, 0.15);\n}\n\n/* General form container styling */\n.form-container {\n    width: 100% !important;\n    max-width: 450px !important;\n    margin: 20px auto !important;\n    padding: 30px !important;\n    background-color: var(--background-color) !important;\n    border: 1px solid var(--border-color) !important;\n    border-radius: 10px !important;\n    box-shadow: 0 8px 12px var(--shadow-light) !important;\n    font-family: Arial, sans-serif !important;\n    animation: fadeIn 0.5s ease-in-out !important;\n}\n\n/* Form Section Titles */\n.form-section-title h2 {\n    text-align: center !important;\n    color: var(--accent-color) !important;\n    font-size: 26px !important;\n    font-weight: bold !important;\n    border-bottom: 2px solid var(--accent-color) !important;\n    padding-bottom: 10px !important;\n    margin-bottom: 25px !important;\n}\n\n/* Label Styling */\n.form-container label {\n    font-size: 14px !important;\n    color: var(--text-color) !important;\n    display: block !important;\n    margin-bottom: 8px !important;\n    font-weight: 500 !important;\n}\n\n/* Input Field Styling */\n.form-container input[type=\"email\"] {\n    width: 100% !important;\n    padding: 12px 15px !important;\n    margin-bottom: 20px !important;\n    border: 1px solid var(--border-color) !important;\n    border-radius: 6px !important;\n    font-size: 15px !important;\n    color: #495057 !important;\n    background-color: var(--input-bg-color) !important;\n    box-shadow: inset 0 1px 3px var(--shadow-light) !important;\n    transition: all 0.3s ease !important;\n}\n\n/* Input Focus Styling */\n.form-container input[type=\"email\"]:focus {\n    border-color: var(--accent-color) !important;\n    outline: none !important;\n    box-shadow: 0 0 4px rgba(69, 123, 157, 0.6) !important;\n}\n\n/* Button Styling */\n.form-container .btn {\n    display: block !important;\n    width: 100% !important;\n    padding: 12px 20px !important;\n    background-color: var(--primary-color) !important;\n    color: white !important;\n    font-size: 16px !important;\n    font-weight: bold !important;\n    text-transform: uppercase !important;\n    border: none !important;\n    border-radius: 6px !important;\n    cursor: pointer !important;\n    text-align: center !important;\n    letter-spacing: 1px !important;\n    transition: background-color 0.3s ease, box-shadow 0.3s ease !important;\n}\n\n/* Button Hover State */\n.form-container .btn:hover {\n    background-color: var(--primary-dark) !important;\n    box-shadow: 0 4px 8px var(--shadow-dark) !important;\n}\n\n/* Button Active State */\n.form-container .btn:active {\n    background-color: var(--primary-darker) !important;\n    box-shadow: inset 0 4px 6px var(--shadow-dark) !important;\n}\n\n/* Error Message Styling */\n.form-container .error-message {\n    color: var(--error-color) !important;\n    font-size: 13px !important;\n    margin-top: -10px !important;\n    margin-bottom: 15px !important;\n    font-weight: bold !important;\n}\n\n/* Success Message Styling */\n.form-container .success-message {\n    color: var(--success-color) !important;\n    font-size: 14px !important;\n    margin-bottom: 15px !important;\n    font-weight: bold !important;\n}\n\n/* Subtle Animation */\n@keyframes fadeIn {\n    from {\n        opacity: 0 !important;\n        transform: translateY(-20px) !important;\n    }\n    to {\n        opacity: 1 !important;\n        transform: translateY(0) !important;\n    }\n}\n\n\n<\/style>\n\n"
