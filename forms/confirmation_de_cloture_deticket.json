                        "className": "org.joget.apps.form.lib.CustomHTML",
                        "properties": {
                            "requiredSanitize": "",
                            "autoPopulate": "",
                            "label": "",
                            "id": "field21",
                            "value": "<script>\n$(document).ready(function () {\n    const msg = \"Votre décision a été validée avec succès.\";\n    const flashmsg = \"success\";\n    const pageUrl = \"mes_reclamation\";\n\n    function generateRedirectUrl(msg, flashmsg, page = pageUrl) {\n        let base = `${window.location.protocol}//${window.location.host}/jw/web/userview/appcenter/home/_/${page}`;\n        const params = [];\n        if (flashmsg !== \"false\") params.push(`flash=${encodeURIComponent(flashmsg)}`);\n        if (msg !== \"false\") params.push(`msg=${encodeURIComponent(msg)}`);\n        return params.length > 0 ? `${base}?${params.join(\"&\")}` : base;\n    }\n\n    const finalRedirectUrl = generateRedirectUrl(msg, flashmsg);\n\n    // Handle assignment complete button\n    try {\n        $('#assignmentComplete').on('click', function () {\n            localStorage.setItem('redirectUrl', finalRedirectUrl);\n        });\n    } catch (e) {}\n\n    // Handle save as draft\n    try {\n        const draftPageUrl = $('#draftPageUrl').val();\n        if (draftPageUrl) {\n            $('#saveAsDraft').on('click', function () {\n                const draftRedirectUrl = generateRedirectUrl(\"Brouillon enregistré\", \"success\", draftPageUrl);\n                localStorage.setItem('redirectUrl', draftRedirectUrl);\n            });\n        }\n    } catch (e) {}\n\n    // Check if user already has a demande (display modal)\n    const demandeUser = $('#verification_process').val();\n    const host = `${window.location.protocol}//${window.location.host}/jw`;\n\n    if (demandeUser === 'false') {\n        const msgHTML = `<p><i class=\"fa fa-exclamation-triangle heartbeat-icon\" style=\"color: red;\"><\/i> Vous avez déjà une demande en cours.<\/p>`;\n\n        $('#confirmationModal .modal-body').html(msgHTML);\n        $('#confirmationModal').modal({ backdrop: 'static', keyboard: false });\n\n        // Confirm (\"Oui\" button) → Complete + Redirect\n        $(\"#confirmationModal .confirm-primary, #confirmationModal .confirm-secondary\").on(\"click\", function () {\n            $('#confirmationModal').modal('hide');\n            $.blockUI({\n                css: {\n                    border: 'none',\n                    padding: '15px',\n                    backgroundColor: '#000',\n                    borderRadius: '10px',\n                    opacity: .3,\n                    color: '#fff'\n                },\n                message: \"<h1>Veuillez patienter...<\/h1>\"\n            });\n\n            try {\n                if (typeof AssignmentManager !== \"undefined\") {\n                    AssignmentManager.completeAssignment(false, false);\n                }\n            } catch (e) {\n                console.error(\"Erreur lors de la complétion de l'assignement\", e);\n            }\n\n            setTimeout(() => {\n                window.location.href = finalRedirectUrl;\n            }, 1000);\n        });\n    }\n});\n<\/script>\n\n<style>\n@keyframes heartbeat {\n    0% {\n        transform: scale(1);\n    }\n    50% {\n        transform: scale(1.2);\n    }\n    100% {\n        transform: scale(1);\n    }\n}\n.heartbeat-icon {\n    animation: heartbeat 1s infinite;\n}\n.container {\n    overflow: hidden;\n}\n<\/style>\n\n\n\n<div class=\"modal fade\" id=\"confirmationModal1\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"confirmationModalLabel1\" aria-hidden=\"true\">\n  <div class=\"modal-dialog\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h5 class=\"modal-title\" id=\"confirmationModalLabel1\">Confirmation<\/h5>\n        <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\" aria-label=\"Close\">\n          <span aria-hidden=\"true\">&times;<\/span>\n        <\/button>\n      <\/div>\n      <div class=\"modal-body\">\n        <p>Confirmez-vous la soumission de votre décision ?<\/p>\n      <\/div>\n      <div class=\"modal-footer\">\n        <button type=\"button\" class=\"btn btn-primary confirm-secondary\">Oui<\/button>\n        <button type=\"button\" class=\"btn btn-primary cancel-secondary\" data-dismiss=\"modal\">Non<\/button>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n"
                        }
