                            "label": "",
                            "id": "field4",
                            "value": "\r\n<div id=\"quota-alert\" style=\"text-align: left; color: red; font-weight: bold; font-size: 20px;\">\r\n    <span style=\"color: red; animation: breath 2s infinite;\">🚨<\/span>\r\n    Confirmez-vous le lancement de la réinscription pour cette liste d'étudiants ? <\/br>\r\n    Merci de réviser la liste, car une fois le processus de réinscription lancé, il ne pourra plus être annulé.\r\n<\/div>\r\n\r\n<iframe id='iframe_objectif' src=\"\" width=\"100%\" height=\"800px\"><\/iframe>\r\n\r\n\r\n<script>\r\n $(document).ready(function() {\r\n            // Scroll to the top of the page\r\n            $('html, body').animate({ scrollTop: 0 });\r\n        });\r\n    $(document).ready(function() {  \r\n\r\n    const iframeSrc = `/jw/web/userview/appcenter/home/_/visualisation_des_etudiants_insc?embed=true`;\r\n\r\n    // Set the src attribute of the iframe\r\n    document.getElementById('iframe_objectif').src = iframeSrc;\r\n\r\n            \r\n        });\r\n        \r\n\r\n<\/script>\r\n<style>\r\n    @keyframes breath {\r\n    0% { opacity: 1; }\r\n    50% { opacity: 0.5; }\r\n    100% { opacity: 1; }\r\n}\r\n\r\n#iframe_objectif {\r\n    border: none;\r\n    background: white !important;\r\n}\r\n\r\nbody {\r\n    overflow: auto; /* Allow scrolling */\r\n}\r\n\r\n<\/style>"
