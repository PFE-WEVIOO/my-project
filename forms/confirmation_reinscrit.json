        {
            "elements": [{
                "elements": [{
                    "className": "org.joget.apps.form.lib.CustomHTML",
                    "properties": {
                        "requiredSanitize": "",
                        "autoPopulate": "",
                        "label": "",
                        "id": "field21",
                        "value": "\r\n<style>\r\n  /* Ensure that all BlockUI elements are hidden */\r\n  .blockUI, .blockMsg, .blockPage, .blockUI.blockOverlay {\r\n    display: none !important;\r\n  }\r\n  #cancel {\r\n      display:none !important;\r\n  }\r\n<\/style>\r\n\r\n<script>\r\n/**\r\n * Main script for handling assignment-related actions, modals, and redirects.\r\n * Consolidated and optimized from the original code.\r\n */\r\n(function () {\r\n    // Constants and configuration\r\n    const CONFIG = {\r\n        baseUrl: `${window.location.protocol}//${window.location.host}/jw`,\r\n        defaultPage: 'welcome',\r\n        appCenterPath: '/web/userview/appcenter/home/_/',\r\n        inboxPath: '/web/userview/#envVariable.appId#/home/_/_ja_inbox',\r\n        messages: {\r\n            success: 'Les ré-inscriptions sont lancées avec succès.',\r\n            draft: 'Brouillon enregistré',\r\n            cancel: 'Action annulé'\r\n        },\r\n        flash: 'success'\r\n    };\r\n\r\n    // Utility function to generate redirect URLs\r\n    function generateRedirectUrl(msg, flashmsg, page = CONFIG.defaultPage) {\r\n        const base = `${CONFIG.baseUrl}${CONFIG.appCenterPath}${page}`;\r\n        const params = [];\r\n        if (flashmsg !== 'false') params.push(`flash=${encodeURIComponent(flashmsg)}`);\r\n        if (msg !== 'false') params.push(`msg=${encodeURIComponent(msg)}`);\r\n        return params.length > 0 ? `${base}?${params.join('&')}` : base;\r\n    }\r\n\r\n    // Utility function to remove query parameter from URL\r\n    function removeQueryParam(param, url) {\r\n        const urlObj = new URL(url);\r\n        urlObj.searchParams.delete(param);\r\n        return urlObj.href;\r\n    }\r\n\r\n    // Reload top window with assignment details\r\n    function reloadTopWindow() {\r\n        const url = `${CONFIG.inboxPath}?_mode=assignment&activityId=#assignment.activityId#`;\r\n        console.log('Reloading top window:', url);\r\n        window.location.href = url;\r\n    }\r\n\r\n    // Show confirmation modal with a custom message\r\n    function showConfirmationModal(message) {\r\n        $('#confirmationModal .modal-body').html(message);\r\n        $('#confirmationModal').modal({\r\n            backdrop: 'static',\r\n            keyboard: false\r\n        });\r\n    }\r\n\r\n    // Initialize on document ready\r\n    $(document).ready(function () {\r\n        // Check initial action\r\n        if ('#requestParam._action#' === 'assignmentView') {\r\n            reloadTopWindow();\r\n        }\r\n\r\n        // URL parameters and redirect URLs\r\n        const urlParams = new URLSearchParams(window.location.search);\r\n        const activityId = urlParams.get('activityId');\r\n        const finalRedirectUrl = generateRedirectUrl(CONFIG.messages.success, CONFIG.flash);\r\n        const draftRedirectUrl = generateRedirectUrl(CONFIG.messages.draft, CONFIG.flash);\r\n        const cancelRedirectUrl = generateRedirectUrl(CONFIG.messages.cancel, CONFIG.flash);\r\n\r\n        // Log redirect URLs for debugging\r\n        console.log('finalRedirectUrl:', finalRedirectUrl);\r\n        console.log('draftRedirectUrl:', draftRedirectUrl);\r\n        console.log('cancelRedirectUrl:', cancelRedirectUrl);\r\n\r\n        // Check for element existence\r\n        const elements = [\r\n            { id: '#assignmentComplete', name: 'assignmentComplete' },\r\n            { id: '#saveAsDraft', name: 'saveAsDraft' },\r\n            { id: '#cancelAction', name: 'cancelAction' },\r\n            { id: '#draftPageUrl', name: 'draftPageUrl' }\r\n        ];\r\n        elements.forEach(({ id, name }) => {\r\n            if (!$(id).length) {\r\n                console.warn(`Element ${id} not found on the page`);\r\n            } else if (id === '#draftPageUrl') {\r\n                console.log('draftPageUrl value:', $(id).val());\r\n            }\r\n        });\r\n\r\n        // Handle assignment completion\r\n        $('#assignmentComplete').on('click', function (event) {\r\n            event.preventDefault();\r\n            console.log('Assignment complete clicked, storing redirectUrl:', finalRedirectUrl);\r\n            localStorage.setItem('redirectUrl', finalRedirectUrl);\r\n            $('#confirmationModal1').modal('show');\r\n        });\r\n\r\n        // Handle save as draft\r\n        $('#saveAsDraft').on('click', function () {\r\n            console.log('Save as draft clicked, storing redirectUrl:', draftRedirectUrl);\r\n            localStorage.setItem('redirectUrl', draftRedirectUrl);\r\n        });\r\n\r\n        // Confirmation modal handlers\r\n        $('#confirmationModal1 .confirm-secondary').on('click', function (event) {\r\n            event.preventDefault();\r\n            $('#confirmationModal1').modal('hide');\r\n            $('#assignmentComplete, #submit').off('click').trigger('click');\r\n        });\r\n\r\n        $('#confirmationModal1 .cancel-secondary').on('click', function () {\r\n            $('#confirmationModal1').modal('hide');\r\n        });\r\n\r\n        // Check user verification status\r\n        const demandeUser = document.getElementById('verification_process')?.value;\r\n        if (demandeUser === 'false') {\r\n            const modalMessage = `\r\n                <p>\r\n                    <i class=\"fa fa-exclamation-triangle heartbeat-icon\" style=\"color: red;\"><\/i>\r\n                    Vous avez déjà une demande en cours.\r\n                <\/p>`;\r\n            showConfirmationModal(modalMessage);\r\n        }\r\n\r\n        // Handle primary confirmation button\r\n        $('#confirmationModal .confirm-primary').on('click', function () {\r\n            $('#confirmationModal').modal('hide');\r\n            $.blockUI({\r\n                css: {\r\n                    border: 'none',\r\n                    padding: '15px',\r\n                    backgroundColor: '#000',\r\n                    '-webkit-border-radius': '10px',\r\n                    '-moz-border-radius': '10px',\r\n                    opacity: 0.3,\r\n                    color: '#fff'\r\n                },\r\n                message: '<h1>Please wait...<\/h1>'\r\n            });\r\n\r\n            AssignmentManager.completeAssignmentWithVariable(\r\n                CONFIG.baseUrl,\r\n                activityId,\r\n                'var_verif_kill=false'\r\n            );\r\n            window.location.href = `${CONFIG.baseUrl}${CONFIG.appCenterPath}${CONFIG.defaultPage}`;\r\n        });\r\n\r\n        // Create and append custom cancel button\r\n        const sectionActions = document.querySelector('#section-actions .form-column');\r\n        if (sectionActions) {\r\n            const customButton = document.createElement('button');\r\n            customButton.id = 'customButton';\r\n            customButton.className = 'form-button btn btn-primary';\r\n            customButton.innerText = 'Annuler';\r\n            customButton.style.backgroundColor = 'red';\r\n            customButton.style.color = 'white';\r\n\r\n            const formCell = document.createElement('div');\r\n            formCell.className = 'form-cell';\r\n            formCell.appendChild(customButton);\r\n            sectionActions.appendChild(formCell);\r\n\r\n            // Handle custom button click\r\n            customButton.addEventListener('click', function () {\r\n                console.log('Cancel action clicked, storing redirectUrl:', cancelRedirectUrl);\r\n                localStorage.setItem('redirectUrl', cancelRedirectUrl);\r\n                AssignmentManager.completeAssignmentWithVariable(\r\n                    CONFIG.baseUrl,\r\n                    activityId,\r\n                    'var_verif_kill=false'\r\n                ).catch(error => {\r\n                    console.error('Error in completeAssignmentWithVariable:', error);\r\n                });\r\n            });\r\n        }\r\n    });\r\n})();\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<\/script>\r\n\r\n<!-- Second Modal -->\r\n<div class=\"modal fade\" id=\"confirmationModal1\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"confirmationModalLabel1\" aria-hidden=\"true\">\r\n  <div class=\"modal-dialog\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-header\">\r\n        <h5 class=\"modal-title\" id=\"confirmationModalLabel1\">Confirmation<\/h5>\r\n        <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\" aria-label=\"Close\">\r\n          <span aria-hidden=\"true\">&times;<\/span>\r\n        <\/button>\r\n      <\/div>\r\n      <div class=\"modal-body\">\r\n        <p>Confirmez-vous le lancement du processus de réinscription pour cette liste d'étudiants ?<\/p>\r\n      <\/div>\r\n      <div class=\"modal-footer\">\r\n        <button type=\"button\" class=\"btn btn-primary confirm-secondary\">Oui<\/button>\r\n        <button type=\"button\" class=\"btn btn-primary cancel-secondary\" data-dismiss=\"modal\">Non<\/button>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n<\/div>\r\n\r\n\r\n"
                    }
                }],
