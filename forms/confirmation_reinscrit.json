                "loadBinder": {
                    "className": "org.joget.apps.form.lib.BeanShellFormBinder",
                    "properties": {
                        "autoHandleWorkflowVariable": "true",
                        "cacheInterval": "",
                        "script": "import org.joget.apps.form.model.FormRow;\r\nimport org.joget.apps.form.model.FormRowSet;\r\nimport org.joget.workflow.model.service.WorkflowManager;\r\nimport org.joget.commons.util.LogUtil;\r\nimport org.joget.apps.app.service.AppUtil;\r\n\r\nWorkflowManager workflowManager = (WorkflowManager) AppUtil.getApplicationContext().getBean(\"workflowManager\");\r\n\r\n// Initialize the FormRow and FormRowSet objects\r\nFormRow r1 = new FormRow();\r\nFormRowSet f = new FormRowSet();\r\n\r\ntry {\r\n    // Check the assignment size for the specified process\r\n    int size = workflowManager.getAssignmentSize(true, \"appcenter:latest:re_inscrits_dir\");\r\n\r\n    // If size is greater than 1, set \"verification_process\" to \"false\" in FormRow r1\r\n    if (size > 1) {\r\n        r1.put(\"verification_process\", \"false\");\r\n    }\r\n\r\n    // Add r1 to the FormRowSet\r\n    f.add(r1);\r\n\r\n} catch (Exception e) {\r\n    LogUtil.error(\"AssignmentCheck\", e, \"Error while checking assignment size or adding to FormRowSet.\");\r\n}\r\n\r\nreturn f;\r\n",
                        "autoHandleFiles": ""
