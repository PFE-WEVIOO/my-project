                            "label": "",
                            "id": "field21",
                            "value": "\r\n<script>\r\n\r\n$(document).ready(function() {\r\n    $(\"#submit\").on(\"click\", function(event) {\r\n        event.preventDefault();\r\n        // Show the custom popup\r\n        $('#confirmationModal1').modal('show');\r\n    });\r\n\r\n    // Handle the custom popup confirmation\r\n\r\n\r\n\r\n\r\n\r\n$(\"#confirmationModal1 .confirm-secondary\").on(\"click\", function(event) {\r\n    event.preventDefault(); // Prevent default behavior to ensure our logic works\r\n\r\n    $('#confirmationModal1').modal('hide');\r\n    $(\"#assignmentComplete, #submit\").off(\"click\").trigger(\"click\");\r\n\r\n    var msgFlash = document.getElementById('msg_flash').value;\r\n    var typeFlash = document.getElementById('type_flash').value;\r\n\r\n    // Construct the redirect URL with the parameters\r\n    var redirectUrl = '/jw/web/userview/appcenter/home/_/welcome?type=' + encodeURIComponent(typeFlash) + '&msg=' + encodeURIComponent(msgFlash);\r\n\r\n    // Override window.alert to suppress the alert box\r\n    window.alert = function(message) {\r\n        console.log('Alert suppressed:', message); // Log the message instead of showing it\r\n        // You can also handle custom error behavior here if needed\r\n    };\r\n\r\n    setTimeout(function() {\r\n        var errorMessageElement = document.querySelector(\".form-message.form-errors\");\r\n\r\n        // If the error message element does not exist after 1 second, proceed with redirection\r\n        if (!errorMessageElement) {\r\n            // Proceed with the redirection\r\n            window.location.href = redirectUrl;\r\n        }\r\n    }, 700); // Increased timeout to 1 second for more reliable completion\r\n});\r\n\r\n\r\n\r\n\r\n\r\n    // Handle the custom popup cancellation\r\n    $(\"#confirmationModal1 .cancel-secondary\").on(\"click\", function(event) {\r\n        $('#confirmationModal1').modal('hide');\r\n    });\r\n});\r\n\r\n<\/script>\r\n<!-- Second Modal -->\r\n<div class=\"modal fade\" id=\"confirmationModal1\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"confirmationModalLabel1\" aria-hidden=\"true\">\r\n  <div class=\"modal-dialog\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-header\">\r\n        <h5 class=\"modal-title\" id=\"confirmationModalLabel1\">Confirmation<\/h5>\r\n        <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\" aria-label=\"Close\">\r\n          <span aria-hidden=\"true\">&times;<\/span>\r\n        <\/button>\r\n      <\/div>\r\n      <div class=\"modal-body\">\r\n        <p>Confirmez-vous la soumission de l'action d'injection des résultats ?/p>\r\n      <\/div>\r\n      <div class=\"modal-footer\">\r\n        <button type=\"button\" class=\"btn btn-primary confirm-secondary\">Oui<\/button>\r\n        <button type=\"button\" class=\"btn btn-primary cancel-secondary\" data-dismiss=\"modal\">Non<\/button>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n<\/div>\r\n"
                        }
