            "properties": {"script": "import org.json.JSONArray;\nimport org.json.JSONObject;\nimport org.joget.apps.form.model.*;\nimport org.joget.apps.form.service.*;\nimport org.joget.apps.app.service.*;\nimport java.sql.*;\nimport java.util.*;\nimport java.text.*;\nimport javax.sql.DataSource;\nimport org.joget.commons.util.LogUtil;\n\nConnection con = null;\nDataSource ds = (DataSource) AppUtil.getApplicationContext().getBean(\"setupDataSource\");\n\ntry {\n    con = ds.getConnection();\n\n    if (!con.isClosed()) {\n        // Define the UPDATE query with placeholders for secure parameterization\n        String updateQuery = \"UPDATE app_fd_quotas SET c_quota = '' WHERE c_quota_check = ? AND id = ?\";\n\n        // Prepare the statement\n        PreparedStatement stmt = con.prepareStatement(updateQuery);\n\n        // Set the parameters (replace these variables with actual data from your form or context)\n        String quotaCheck = \"non\";  // Example value\n        String id = \"#form.app_fd_quotas.id#\";        // Example value\n\n        stmt.setString(1, quotaCheck);\n        stmt.setString(2, id);\n\n        // Execute the update\n        int rowsUpdated = stmt.executeUpdate();\n\n        // Log the number of rows updated\n    }\n} catch (Exception e) {\n    LogUtil.error(\"Sample app - Update Operation\", e, \"Error executing update query\");\n} finally {\n    try {\n        if (con != null) {\n            con.close();\n        }\n    } catch (Exception ex) {\n        LogUtil.error(\"Script Cleanup\", ex, \"Error closing database connection\");\n    }\n}\n"}
