                {
                    "className": "org.joget.apps.form.lib.CustomHTML",
                    "properties": {
                        "requiredSanitize": "",
                        "autoPopulate": "",
                        "label": "",
                        "id": "field2",
                        "value": "<div class=\"modal fade\" id=\"confirmationModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"confirmationModalLabel\" aria-hidden=\"true\">\n<div class=\"modal-dialog\">\n<div class=\"modal-content\">\n<div class=\"modal-header\">\n<h5 class=\"modal-title\" id=\"confirmationModalLabel\">Validation Error<\/h5>\n<\/div>\n<div class=\"modal-body\">\n<p><i class=\"fa fa-exclamation-triangle heartbeat-icon\" style=\"color: red;\"><\/i> Vous avez déjà une demande en cours.<\/p>\n<\/div>\n<div class=\"modal-footer\">\n<button type=\"button\" class=\"btn btn-primary\" id=\"retournerButton\" data-bs-dismiss=\"modal\">Retourner<\/button>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n \n<style>\n \n@keyframes heartbeat {\n    0% {\n        transform: scale(1);\n    }\n    50% {\n        transform: scale(1.2);\n    }\n    100% {\n        transform: scale(1);\n    }\n}\n.heartbeat-icon {\n    animation: heartbeat 1s infinite;\n}\n.container {\n    overflow: hidden;\n}\n.modal-backdrop.show {\n    z-index: 1040;\n}\n.modal-open .modal {\n    z-index: 1050;\n}\n.modal-open {\n    pointer-events: none;\n}\n.modal-open #confirmationModal {\n    pointer-events: auto;\n}\n<\/style>\n \n<script>\n$(document).ready(function() {\n    // Select the label for 'specialite'\n    var label = document.querySelector('label[for=\"specialite\"]');\n    // Check if the validation error span exists\n    var errorSpan = label.querySelector('.form-error-message');\n    // If the validation error span exists, show the modal and prevent submission\n    if (errorSpan) {\n \n        // Set the kill_process field to true\n        // Get modal content (check if it exists)\n        var modalBody = document.querySelector('#confirmationModal .modal-body p');\n        if (modalBody) {\n            // Update modal content with the validation error\n            modalBody.innerHTML = '<i class=\"fa fa-exclamation-triangle heartbeat-icon\" style=\"color: red;\"><\/i> ' + errorSpan.textContent;\n \n            // Show the overlay\n            $('#modalOverlay').show();\n \n            // Show the modal with static backdrop and no keyboard option\n            var confirmationModal = new bootstrap.Modal(document.getElementById('confirmationModal'), {\n                backdrop: 'static',\n                keyboard: false\n            });\n            confirmationModal.show();\n        } else {\n            console.error('Modal content not found. Ensure the modal structure is correct.');\n        }\n    }\n \n    // Handle \"Retourner\" button click\n    $(\"#retournerButton\").on(\"click\", function(event) {\n        // Get URL parameters\n        const urlParams = new URLSearchParams(window.location.search);\n        const activityId = urlParams.get('activityId');\n        // Define host and redirect URL\n        var host = window.location.protocol + \"//\" + window.location.host + \"/jw\";\n        var redirectUrl = host + '/web/userview/appcenter/home/_/welcome';\n        console.log(activityId);\n \n        // Hide the modal and overlay\n        $('#confirmationModal').modal('hide');\n        $('#modalOverlay').hide();\n        // Block UI and complete the assignment\n        $.blockUI({\n            css: {\n                border: 'none',\n                padding: '15px',\n                backgroundColor: '#000',\n                '-webkit-border-radius': '10px',\n                '-moz-border-radius': '10px',\n                opacity: .3,\n                color: '#fff'\n            }, message: \"<h1>Please wait...<\/h1>\"\n        });\n        // Complete the assignment and pass the workflow variable\n        AssignmentManager.completeAssignmentWithVariable(host, activityId,\"var_status=true\");\n \n        // Redirect after assignment completion\n        window.location.href = redirectUrl;\n    });\n});\n<\/script>"
                    }
