                        "script": "import org.json.JSONArray;\r\nimport org.json.JSONObject;\r\nimport org.joget.apps.form.model.*;\r\nimport org.joget.apps.form.service.*;\r\nimport org.joget.apps.app.service.*;\r\nimport java.sql.*;\r\nimport java.util.*;\r\nimport org.joget.commons.util.LogUtil;\r\nimport javax.sql.DataSource;\r\nimport org.joget.workflow.util.WorkflowUtil;\r\nimport javax.servlet.http.HttpServletResponse;\r\nConnection con = null;\r\nDataSource ds = (DataSource) AppUtil.getApplicationContext().getBean(\"setupDataSource\");\r\n\r\nString redirect = \"#requestParam.redirect#\";\r\nString id = \"#currentUser.username#\"; // Retrieve current user's email address\r\nString nat = \"\"; // Variable to store the director's ID\r\n            LogUtil.warn(\"Director ID found:\", redirect); // Log the retrieved ID\r\n\r\ntry {\r\n    // Initialize DataSource and get the database connection\r\n    ds = (DataSource) AppUtil.getApplicationContext().getBean(\"setupDataSource\");\r\n    con = ds.getConnection();\r\n\r\n    if (!con.isClosed()) {\r\n        // Prepare and execute SQL query to find the director's ID using email\r\n        PreparedStatement stmt1 = con.prepareStatement(\"SELECT id FROM jwdb.app_fd_directeurs WHERE c_adresse_electronique_directeur LIKE ?;\");\r\n        stmt1.setString(1, id); // Set email parameter\r\n        ResultSet rs = stmt1.executeQuery();\r\n\r\n        // Retrieve the director's ID if found\r\n        while (rs.next()) {\r\n            nat = rs.getString(\"id\");\r\n            LogUtil.warn(\"Director ID found:\", nat); // Log the retrieved ID\r\n        }\r\n    }\r\n} catch (Exception e) {\r\n    // Log any exceptions that occur during database interaction\r\n    LogUtil.error(\"Error loading user data in load binder\", e, \"Failed to retrieve director ID\");\r\n} finally {\r\n    try {\r\n        // Ensure the connection is closed after use\r\n        if (con != null) {\r\n            con.close();\r\n        }\r\n    } catch (Exception ex) {\r\n        LogUtil.error(\"Script cleanup\", ex, \"Error closing connection\");\r\n    }\r\n}\r\nif(redirect != \"false\"){\r\n    \r\n\r\nHttpServletResponse response = WorkflowUtil.getHttpServletResponse();\r\nresponse.sendRedirect(\"/jw/web/userview/appcenter/home/_/visualisation_etab?id=\"+nat+\"&redirect=false\");\r\n}\r\n",
