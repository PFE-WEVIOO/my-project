            "sql": "\nSELECT a.*\nFROM app_fd_calendrier a\nJOIN app_fd_inscription_etud b \nON a.c_etablissement = (\n    SELECT id \n    FROM app_fd_etablissement \n    WHERE c_etablissement = b.c_etablissement\n) where b.id = '#currentUser.email#'\n",
