            "format": {
                "className": "org.joget.BeanShellFormatter",
                "properties": {"script": "import java.sql.Connection;\r\nimport java.sql.PreparedStatement;\r\nimport java.sql.ResultSet;\r\nimport java.sql.SQLException;\r\nimport javax.sql.DataSource;\r\nimport org.joget.apps.app.service.AppUtil;\r\nimport org.joget.commons.util.LogUtil;\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\nimport org.joget.commons.util.UuidGenerator;\r\n\r\nDataSource ds = (DataSource) AppUtil.getApplicationContext().getBean(\"setupDataSource\");\r\nConnection con = null;\r\nPreparedStatement stmt = null;\r\nResultSet rs = null;\r\n\r\nString libelle = \"\";\r\nString[] ids = value.split(\";\");  // Split the value by ';'\r\nList libelleList = new ArrayList();  // To store retrieved c_formation\r\n\r\ntry {\r\n    con = ds.getConnection();\r\n\r\n    if (!con.isClosed()) {\r\n        // Loop through each id\r\n        for (String id : ids) {\r\n            String selectSql = \"SELECT c_formation FROM app_fd_formations WHERE id = ?\";\r\n\r\n            stmt = con.prepareStatement(selectSql);\r\n            stmt.setString(1, id);\r\n\r\n            rs = stmt.executeQuery();\r\n            if (rs.next()) {\r\n                String cFormation = rs.getString(\"c_formation\");\r\n                libelleList.add(cFormation);  // Add c_formation to the list\r\n            }\r\n        }\r\n\r\n        // Concatenate all c_formation values with '-' delimiter\r\n        libelle = String.join(\" || \", libelleList);\r\n    }\r\n} catch (SQLException e) {\r\n    LogUtil.error(\"CustomScript\", e, \"Error retrieving formations\");\r\n} finally {\r\n    try {\r\n        if (rs != null) rs.close();\r\n        if (stmt != null) stmt.close();\r\n        if (con != null) con.close();\r\n    } catch (Exception ex) {\r\n        LogUtil.error(\"CustomScript\", ex, \"Error closing resources\");\r\n    }\r\n}\r\n\r\n// Return the concatenated string as an HTML span element\r\nreturn \"<span>\" + libelle + \"<\/span>\";\r\n"}
            },
