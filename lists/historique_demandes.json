        {
            "className": "org.joget.BshAction",
            "id": "rowAction_3",
            "properties": {
                "link-style-background-color": "#FF0000",
                "rules": [{
                    "field": "steps",
                    "join": "AND",
                    "value": "1",
                    "operator": "="
                }],
                "label": "<i class=\"fa fa-trash\" aria-hidden=\"true\"><\/i> ",
                "link-css-display-type": "btn btn-sm btn-primary",
                "datalist_type": "row_action",
                "script": "import java.sql.Connection;\nimport java.sql.PreparedStatement;\nimport java.sql.ResultSet;\nimport java.sql.SQLException;\nimport javax.sql.DataSource;\nimport org.joget.apps.app.service.AppUtil;\nimport org.joget.commons.util.LogUtil;\nimport org.joget.apps.app.service.AppUtil;\nimport org.joget.workflow.model.service.WorkflowManager;\nimport org.joget.commons.util.LogUtil;\n\n\n  for (String key : rowKeys) {\n      \n                  LogUtil.info(\"<+++++ value form +++++++++++>\", key);\n\n\n\nWorkflowManager workflowManager = (WorkflowManager) AppUtil.getApplicationContext().getBean(\"workflowManager\");\nConnection con = null;\ntry {\n    DataSource ds = (DataSource)AppUtil.getApplicationContext().getBean(\"setupDataSource\");\n    con = ds.getConnection();\n    if(!con.isClosed()) {\n        String selectSQL=\"SELECT DISTINCT shk.ActivityProcessDefName, shk.ActivityProcessId, shk.ActivityId,e.c_mail_directeur FROM jwdb.SHKAssignmentsTable AS shk JOIN jwdb.app_fd_inscription_ecole AS e ON shk.ActivityProcessId = e.c_activityprocessid where e.id like '\"+key+\"';\";\n        PreparedStatement stmtSelectFolders = con.prepareStatement(selectSQL);\n        ResultSet rs = stmtSelectFolders.executeQuery();\n        while (rs.next()) {\n            String c_activityprocessid = rs.getString(\"ActivityProcessId\");\n            String c_processDefId = rs.getString(\"ActivityProcessDefName\");\n            String c_activityId = rs.getString(\"ActivityId\");\n            String c_mail_directeur = rs.getString(\"c_mail_directeur\");\n            LogUtil.info(\" -------------------->  c_activityprocessid-----------> \",c_activityprocessid);\n            LogUtil.info(\" -------------------->  c_processDefId-----------> \",c_processDefId);\n            LogUtil.info(\" -------------------->  c_activityId-----------> \",c_activityId);\n            LogUtil.info(\" -------------------->  c_mail_directeur-----------> \",c_mail_directeur);\n            workflowManager.activityVariable(c_activityId,\"decision\",\"Annuler\");\n            workflowManager.assignmentForceComplete(c_processDefId, c_activityprocessid, c_activityId,c_mail_directeur);\n        }\n            String update_field = \"UPDATE app_fd_inscription_ecole SET c_steps = '2', c_statut = 'Annulé' WHERE id = ?;\";\n            PreparedStatement update_sql = con.prepareStatement(update_field);\n            update_sql.setString(1, key);\n            update_sql.executeUpdate();\n\n        \n        \n    }\n} catch(Exception e) {\n    LogUtil.error(\"assignmentForceComplete \", e, \"Cannnot complete assignment\");\n} finally {\n    try {\n        if(con != null) {\n            con.close();\n        }\n    } catch(SQLException e) {/* ignored */}\n}\n\n\n\n\n\n\n  }\n            \n            \n            ",
                "confirmationMessage": "",
                "header_label": ""
            }
        }
