                "sql_query": "select a.c_nom,a.c_prenom,a.c_date_de_naissance,a.c_genre,a.c_nationalite,a.c_pays_de_naissance,a.c_num_id,a.c_numero_de_telephone ,a.c_email,a.c_id_etudiant,a.c_type_bac,a.c_nature_bac,a.c_annee_bac,a.c_mention,b.c_etablissement,b.c_specialite,b.c_domaine,b.c_niveau,b.c_cycle from app_fd_inscription_etud a join app_fd_inscription_ecole b on a.id = b.createdBy Where b.id",
