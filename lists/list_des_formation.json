            "querySource": "sql",
            "pagination": "",
            "debug": "",
            "sql": "SELECT a.id, a.c_domaine, a.c_specialite, a.c_discipline,  a.c_formation,b.id as tab_id, b.c_etablissement , c.c_adresse_electronique_directeur,\n       (SELECT q.c_quota \n        FROM app_fd_quotas q \n        WHERE q.id = CONCAT(a.id, ';', b.id)) AS quota_value\nFROM app_fd_formations a \nLEFT JOIN app_fd_etablissement b \nON b.c_formation LIKE CONCAT('%', a.id, '%')\nLEFT JOIN app_fd_directeurs c on b.id LIKE c.c_nom_etablissement\nwhere c.c_adresse_electronique_directeur like '#currentUser.username#'\n",
