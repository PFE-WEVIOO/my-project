    "name": "Liste des etudiants inscrits",
    "id": "list_etudiants_inscrits",
    "binder": {
        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "",
            "debug": "",
            "sql": "SELECT b.c_nom,\r\n       b.c_prenom,\r\n       b.c_id_etudiant,\r\n       a.c_annee_universitaire,\r\n       a.c_cycle,\r\n       a.c_domaine,\r\n       a.c_specialite,\r\n       a.c_niveau,\r\n       a.c_statut,\r\n       a.c_mail_directeur,\r\n       a.c_resultat\r\nFROM app_fd_inscription_ecole a\r\nJOIN app_fd_inscription_etud b ON a.c_id_etudiant = b.c_id_etudiant\r\nWHERE a.c_statut = 'Cursus en progression'\r\n  AND a.c_id_etablissement = (\r\n        SELECT c_nom_etablissement\r\n        FROM app_fd_directeurs\r\n        WHERE c_adresse_electronique_directeur = '#currentUser.username#'\r\n      )\r\n  AND (\r\n        a.c_resultat = ''\r\n        OR a.c_resultat IS NULL\r\n        OR a.c_resultat = 'Admissible'\r\n      )\r\n",
            "primaryKey": "id"
        }
    },
