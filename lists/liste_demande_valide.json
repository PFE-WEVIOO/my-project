    "name": "Liste des demandes acceptés",
    "id": "liste_demande_valide",
    "binder": {
        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "",
            "debug": "",
            "sql": "SELECT b.c_nom,\r\n        a.id,\r\n       b.c_prenom,\r\n       b.c_id_etudiant,\r\n       a.c_annee_universitaire,\r\n       a.c_cycle,\r\n       a.c_domaine,\r\n       a.c_specialite,\r\n       a.c_niveau,\r\n       a.c_statut,\r\n       a.c_mail_directeur,\r\n       a.c_resultat\r\nFROM app_fd_inscription_ecole a\r\nJOIN app_fd_inscription_etud b ON a.c_id_etudiant = b.c_id_etudiant\r\nWhere c_statut IN ('Validé', 'Accepté')  AND a.c_id_etablissement = \r\n(SELECT c_nom_etablissement\r\n                               FROM app_fd_directeurs\r\n                               WHERE c_adresse_electronique_directeur = '#currentUser.username#')\r\n",
            "primaryKey": "id"
        }
    },
