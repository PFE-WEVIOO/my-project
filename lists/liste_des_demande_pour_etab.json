        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "",
            "debug": "",
            "sql": "\nselect pf.c_date_action,pf.c_activityprocessid,pf.c_id_etudiant,pf.c_specialite, pf.id,pf.createdByName as 'Nom etudiant',pf.c_domaine as 'Domaine',pf.dateCreated as 'Date demande',pf.c_statut as 'Statut',pf.c_niveau as 'Niveau',pf.c_cycle as 'Cycle',\npf.c_mail_directeur as 'mail_directeur',\nshk.ResourceId,shk.ActivityId \nfrom app_fd_inscription_ecole pf  join SHKAssignmentsTable shk on (pf.c_activityprocessid=shk.ActivityProcessId and shk.ResourceId='#currentUser.username#' )\n\nwhere (pf.c_statut IS NOT NULL or pf.c_statut != '' )\nand pf.c_statut like 'En cours de traitement' or pf.c_statut like 'Validé'",
            "primaryKey": "id"
        }
    },
