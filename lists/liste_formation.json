    "id": "liste_formation",
    "binder": {
        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "true",
            "debug": "",
            "sql": "SELECT \r\n    a.id, \r\n    a.c_domaine, \r\n    a.c_specialite, \r\n    a.c_discipline, \r\n    a.c_formation, \r\n    b.id AS tab_id, \r\n    b.c_etablissement,\r\n    b.c_gouvernorat,\r\n    1 AS c_niveau_demande -- Setting c_niveau_demande to 1 for this part\r\nFROM app_fd_formations a \r\nLEFT JOIN app_fd_etablissement b \r\n    ON b.c_formation LIKE CONCAT('%', a.id, '%')\r\nWHERE a.id NOT IN (\r\n    SELECT c_formation \r\n    FROM app_fd_matrice_corres \r\n)and b.c_etablissement is not null\r\n\r\nUNION ALL -- Use UNION ALL if duplicates are not an issue\r\n\r\nSELECT \r\n    a.id, \r\n    a.c_domaine, \r\n    a.c_specialite, \r\n    a.c_discipline, \r\n    a.c_formation, \r\n    b.id AS tab_id, \r\n    b.c_etablissement,\r\n        b.c_gouvernorat,\r\n\r\n    mc.c_niveau_demande -- Retaining original c_niveau_demande for this part\r\nFROM app_fd_formations a \r\nLEFT JOIN app_fd_etablissement b \r\n    ON b.c_formation LIKE CONCAT('%', a.id, '%')\r\nLEFT JOIN app_fd_matrice_corres mc\r\n    ON mc.c_formation = a.id\r\nWHERE a.id IN ( \r\n    SELECT c_formation \r\n    FROM app_fd_matrice_corres \r\n    WHERE c_diplome_obtenu = 'Bac' \r\n      AND (\r\n          c_nature_bac LIKE CONCAT('%;', '#requestParam.NatureBac#', ';%') OR\r\n          c_nature_bac LIKE CONCAT('%;', '#requestParam.NatureBac#') OR\r\n          c_nature_bac LIKE CONCAT('#requestParam.NatureBac#', ';%') OR\r\n          c_nature_bac = '#requestParam.NatureBac#'\r\n      )\r\n)\r\n",
            "primaryKey": "id"
        }
    },
