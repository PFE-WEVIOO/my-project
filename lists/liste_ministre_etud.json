    "name": "Liste de reclamation de etudiants ministre",
    "id": "liste_ministre_etud",
    "binder": {
        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "",
            "debug": "",
            "sql": "SELECT\r\na.c_date_reclamation,\r\n\r\n    a.id,\r\n    a.c_num_ticket AS \"Numéro Ticket\",\r\n    a.createdByName AS \"Créé Par\",\r\n    a.c_type_de_reclamation AS \"Type Réclamation\",\r\n    a.c_categorie_demande AS \"Catégorie Demande\",\r\n    a.c_categorie_danomalie AS \"Catégorie Anomalie\",\r\n    a.dateCreated AS \"Date Création\",\r\n    a.modifiedByName AS \"Modifié Par\",\r\n    a.c_statut AS \"Statut\",\r\n    b.c_id_etudiant AS \"ID Étudiant\",\r\n    b.c_num_id AS \"Numéro Identification\",\r\n    b.c_nom AS \"Nom\",\r\n    b.c_prenom AS \"Prénom\",\r\n    b.c_etablissement AS \"Etablissement\",\r\n        shk.ResourceId,\r\n    shk.ActivityId,\r\n    a.c_activityprocessid\r\nFROM \r\n    app_fd_reclamation a \r\nLEFT JOIN \r\n    app_fd_inscription_etud b \r\nON \r\n    a.c_mail = b.id\r\n\r\nJOIN \r\n    SHKAssignmentsTable shk \r\nON \r\n    (a.c_activityprocessid = shk.ActivityProcessId AND shk.ResourceId = '#currentUser.username#')\r\nWHERE \r\n    a.c_nature_user = 'Etudiants' or a.c_nature_user = 'Etudiant Inscrit'",
            "primaryKey": "id"
        }
    },
