    "name": "Liste des reclamation pour ministre",
    "id": "reclamation_ministre",
    "binder": {
        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "",
            "debug": "",
            "sql": "SELECT\na.c_date_reclamation,\n\n    a.id,\n    a.c_num_ticket AS \"Numéro Ticket\",\n    a.createdByName AS \"Créé Par\",\n    a.c_type_de_reclamation AS \"Type Réclamation\",\n    a.c_categorie_demande AS \"Catégorie Demande\",\n    a.c_categorie_danomalie AS \"Catégorie Anomalie\",\n    a.dateCreated AS \"Date Création\",\n    a.c_travailleur AS \"Modifié Par\",\n    a.c_statut AS \"Statut\",\n    b.c_id_etudiant AS \"ID Étudiant\",\n    b.c_num_id AS \"Numéro Identification\",\n    b.c_nom AS \"Nom\",\n    b.c_prenom AS \"Prénom\",\n    b.c_etablissement AS \"Etablissement\",\n    d.c_abreviation_agrement AS \"Agrement\",\n    d.c_nom AS \"Nom directeur\",\n    c.c_etablissement AS \"Etablissement directeur\"\nFROM \n    app_fd_reclamation a \nLEFT JOIN \n    app_fd_inscription_etud b \nON \n    a.c_mail = b.id\nLEFT JOIN \n    app_fd_directeurs d \nON \n    a.c_mail = d.c_adresse_electronique_directeur\nLEFT JOIN \n    app_fd_etablissement c \nON \n    d.c_nom_etablissement = c.id\n\n",
            "primaryKey": "id"
        }
    },
