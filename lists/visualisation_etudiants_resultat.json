    "binder": {
        "className": "org.melkart.plugin.JdbcDatalistBinder",
        "properties": {
            "querySource": "sql",
            "pagination": "",
            "debug": "",
            "sql": "select  distinct a.c_resultat,b.c_nom,b.c_prenom,b.c_id_etudiant,a.c_annee_universitaire,a.c_cycle,a.c_domaine,a.c_specialite,a.c_niveau,a.c_statut,a.c_mail_directeur from app_fd_inscription_ecole a join app_fd_inscription_etud b on a.c_id_etudiant=b.c_id_etudiant \nwhere a.c_resultat in (\"Admis\",\"Redoublant\") and a.c_statut like \"Cursus en progression\"\nAND a.c_id_etablissement = (SELECT c_id_etablissement\n                               FROM app_fd_directeurs\n                               WHERE c_adresse_electronique_directeur = '#currentUser.username#')\n",
            "primaryKey": "id"
        }
    },
